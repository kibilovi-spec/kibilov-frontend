'use client';
import Link from 'next/link';
import { CategoryIcon } from '@/components/ui/CategoryIcon';
import { useLang } from '@/store';

interface Cat {
  id: string; slug: string; name?: string;
  nameKa?: string; nameEn?: string; nameRu?: string;
  productCount?: number;
}

export function CategoriesSection({ categories, seeAllLabel, catsLabel }: {
  categories: Cat[]; seeAllLabel?: string; catsLabel?: string;
}) {
  const { lang } = useLang();
  const getName = (cat: Cat) =>
    lang==='en' ? (cat.nameEn||cat.nameKa||cat.name||cat.slug)
    : lang==='ru' ? (cat.nameRu||cat.name)
    : (cat.nameKa||cat.name||cat.slug);

  
const STATIC_IMAGES: Record<string, string> = {
  brakes:      'https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=300&q=80',
  amortizacia: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=300&q=80',
  filters:     'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?w=300&q=80',
  electrics:   'https://images.unsplash.com/photo-1609091839311-d5365f9ff1c5?w=300&q=80',
  engines:     'https://images.unsplash.com/photo-1555215695-3004980ad54e?w=300&q=80',
  steering:    'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=300&q=80',
  clutch:      'https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?w=300&q=80',
  tires:       'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=300&q=80',
  'oils-fluids':'https://images.unsplash.com/photo-1607860108855-64acf2078ed9?w=300&q=80',
  body:        'https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=300&q=80',
  accessories: 'https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=300&q=80',
  glass:       'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=300&q=80',
  cooling:     'https://images.unsplash.com/photo-1631549916768-4119b2e5f926?w=300&q=80',
  driveshaft:  'https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=300&q=80',
  savali:      'https://res.cloudinary.com/dj8wchrkj/image/upload/v1780393070/kibilov/products/844F_6211_A1A.jpg',
};

const PILLS = [
    {slug:'brakes',      ka:'\u10e1\u10d0\u10db\u10e3\u10ee\u10e0\u10e3\u10ed\u10d4 \u10ee\u10e3\u10dc\u10d3\u10d8',    en:'Brake Pads',    ru:'\u0422\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0435 \u043a\u043e\u043b\u043e\u0434\u043a\u0438'},
    {slug:'filters',     ka:'\u10d6\u10d4\u10d7\u10d8\u10e1 \u10e4\u10d8\u10da\u10e2\u10e0\u10d8',   en:'Oil Filter',     ru:'\u041c\u0430\u0441\u043b\u044f\u043d\u044b\u0439 \u0444\u0438\u043b\u044c\u0442\u0440'  },
    {slug:'amortizacia', ka:'\u10d0\u10db\u10dd\u10e0\u10e2\u10d8\u10d6\u10d0\u10e2\u10dd\u10e0\u10d8',    en:'Shock Absorber', ru:'\u0410\u043c\u043e\u0440\u0442\u0438\u0437\u0430\u0442\u043e\u0440'     },
    {slug:'savali',      ka:'\u10e8\u10d0\u10e0\u10d0\u10d5\u10dd',          en:'Ball Joint',     ru:'\u0428\u0430\u0440\u043e\u0432\u0430\u044f \u043e\u043f\u043e\u0440\u0430'         },
    {slug:'brakes',      ka:'\u10e1\u10d0\u10db\u10e3\u10ee\u10e0\u10e3\u10ed\u10d4 \u10d3\u10d8\u10e1\u10d9\u10d8',   en:'Brake Disc',     ru:'\u0422\u043e\u0440\u043c\u043e\u0437\u043d\u043e\u0439 \u0434\u0438\u0441\u043a'    },
    {slug:'savali',      ka:'\u10e1\u10d0\u10d9\u10d8\u10e1\u10d0\u10e0\u10d8',       en:'Wheel Bearing',  ru:'\u041f\u043e\u0434\u0448\u0438\u043f\u043d\u0438\u043a'          },
    {slug:'filters',     ka:'\u10f0\u10d0\u10d4\u10e0\u10d8\u10e1 \u10e4\u10d8\u10da\u10e2\u10e0\u10d8', en:'Air Filter',     ru:'\u0412\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0439 \u0444\u0438\u043b\u044c\u0442\u0440'},
    {slug:'engines',     ka:'\u10d1\u10d0\u10d1\u10d8\u10dc\u10d0',         en:'Ignition Coil',  ru:'\u041a\u0430\u0442\u0443\u0448\u043a\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f'},
    {slug:'cooling',     ka:'\u10e0\u10d0\u10d3\u10d8\u10d0\u10e2\u10dd\u10e0\u10d8',      en:'Radiator',       ru:'\u0420\u0430\u0434\u0438\u0430\u0442\u043e\u0440'             },
    {slug:'steering',    ka:'\u10e2\u10d8\u10d0\u10d2\u10d0',           en:'Tie Rod',        ru:'\u0420\u0443\u043b\u0435\u0432\u0430\u044f \u0442\u044f\u0433\u0430'          },
  ];

  return (
    <section>
      <div className="flex items-center justify-between mb-4">
        <h2 className="section-title">
          <span className="w-1 h-6 bg-primary rounded-full"/>
          {catsLabel || '\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10d4\u10d1\u10d8'}
        </h2>
        <Link href="/products" className="text-xs font-bold text-primary hover:underline">
          {seeAllLabel || '\u10e7\u10d5\u10d4\u10da\u10d0 \u2192'}
        </Link>
      </div>

      <div className="grid grid-cols-3 sm:grid-cols-5 gap-3">
        {categories.length === 0
          ? Array(15).fill(0).map((_,i) => (
              <div key={i} className="bg-white border border-gray-100 rounded-xl animate-pulse">
                <div className="aspect-square bg-gray-100 rounded-t-xl"/>
                <div className="p-2 text-center">
                  <div className="h-2.5 bg-gray-200 rounded w-3/4 mx-auto mb-1"/>
                  <div className="h-2 bg-gray-100 rounded w-1/2 mx-auto"/>
                </div>
              </div>
            ))
          : categories.map(cat => {
            const imgUrl = catImages[cat.slug] || STATIC_IMAGES[cat.slug];
            return (
            <Link key={cat.id} prefetch={false}
              href={`/products?category=${cat.slug}`}
              className="group bg-white border border-gray-100 rounded-xl overflow-hidden hover:border-primary hover:shadow-md transition-all duration-200">
              <div className="aspect-square bg-gray-50 flex items-center justify-center overflow-hidden group-hover:bg-blue-50 transition-colors">
                {imgUrl ? (
                  <img
                    src={imgUrl}
                    alt={getName(cat)}
                    className="w-full h-full object-contain p-2 group-hover:scale-110 transition-transform duration-300"
                    loading="lazy"
                    onError={(e) => { (e.target as HTMLImageElement).style.display='none'; }}
                  />
                ) : (
                  <div className="w-3/4 h-3/4 text-[#1a2f6e] group-hover:text-primary transition-colors">
                    <CategoryIcon slug={cat.slug} className="w-full h-full" color="currentColor"/>
                  </div>
                )}
              </div>
              <div className="px-2 py-2 text-center border-t border-gray-100">
                <div className="text-xs font-semibold text-gray-900 leading-tight line-clamp-2">{getName(cat)}</div>
                {cat.productCount !== undefined && cat.productCount > 0 && (
                  <div className="text-[10px] text-primary font-medium mt-0.5">
                    {cat.productCount} {lang==='ka' ? 'ნაწ.' : 'pcs'}
                  </div>
                )}
              </div>
            </Link>
            );
          })

      </div>

      <div className="mt-4 flex flex-wrap gap-2">
        {PILLS.map((item, i) => (
          <Link key={i}
            href={`/products?category=${item.slug}`}
            className="text-xs font-medium text-gray-700 bg-white border border-gray-200 px-3 py-1.5 rounded-full hover:border-primary hover:text-primary transition-colors whitespace-nowrap">
            {lang==='en' ? item.en : lang==='ru' ? item.ru : item.ka}
          </Link>
        ))}
      </div>
    </section>
  );
}
