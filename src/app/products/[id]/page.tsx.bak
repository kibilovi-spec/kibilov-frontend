import type { Metadata } from 'next';
import ClientProductPage from './client';

async function getProduct(id: string) {
  try {
    const r = await fetch(`http://localhost:3001/api/products/${id}`, {
      next: { revalidate: 3600 }
    });
    if (!r.ok) return null;
    const data = await r.json();
    return data.data || data.product || data;
  } catch { return null; }
}

export async function generateMetadata({ params }: { params: { id: string } }): Promise<Metadata> {
  const p = await getProduct(params.id);
  if (!p) return { title: 'პროდუქტი — kibilov.ge' };
  return {
    title: `${p.nameKa || p.nameEn} — kibilov.ge`,
    description: p.descriptionKa || `${p.nameKa} — ყიდეთ kibilov.ge-ზე. OEM: ${p.oemCodes?.[0] || ''}. ფასი: ${p.price}₾`,
    keywords: [p.nameKa, p.brand, ...(p.oemCodes || [])].filter(Boolean).join(', '),
    openGraph: {
      title: p.nameKa || p.nameEn,
      description: `${p.brand} — ${p.price}₾`,
      images: p.images?.[0] ? [p.images[0]] : [],
    },
  };
}

export default async function ProductPage({ params }: { params: { id: string } }) {
  const p = await getProduct(params.id);

  const jsonLd = p ? {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": p.nameKa || p.nameEn || '',
    "description": p.descriptionKa || p.descriptionEn || '',
    "brand": { "@type": "Brand", "name": p.brand || '' },
    "mpn": p.oemCodes?.[0] || '',
    "image": p.images?.[0] || '',
    "offers": {
      "@type": "Offer",
      "price": p.price || 0,
      "priceCurrency": "GEL",
      "availability": (p.stock > 0) ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "seller": { "@type": "Organization", "name": "Kibilov AutoParts" }
    }
  } : null;

  return (
    <>
      {jsonLd && (
        <script
          type="application/ld+json"
          dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLd) }}
        />
      )}
      {/* SEO content for Google */}
      {p && (
        <div style={{ position: 'absolute', left: '-9999px', top: 0 }} aria-hidden="false">
          <h1>{p.nameKa}</h1>
          <p>ბრენდი: {p.brand}</p>
          <p>ფასი: {p.price}₾</p>
          <p>OEM: {p.oemCodes?.join(', ')}</p>
          <p>{p.descriptionKa}</p>
        </div>
      )}
      <ClientProductPage params={params} initialProduct={p} />
    </>
  );
}
