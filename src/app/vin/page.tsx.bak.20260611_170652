'use client';
import { useState, useRef, useEffect } from 'react';
import api from '@/lib/api';
import Link from 'next/link';

interface VehicleData {
  make: string|null; model: string|null; year: string|null;
  bodyClass: string|null; fuelType: string|null; displacement: string|null;
  engineCyl: string|null; transmission: string|null; plantCountry: string|null;
}
interface VINResult {
  vehicle: VehicleData; score: number; confidence: 'high'|'medium'|'low'; confidenceMsg: string;
}

export default function VINPage() {
  const [vin, setVin] = useState('');
  const [result, setResult] = useState<VINResult|null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [tab, setTab] = useState<'manual'|'camera'|'history'>('manual');
  const [ocrLoading, setOcrLoading] = useState(false);
  const [history, setHistory] = useState<{vin:string, make:string, model:string, year:string}[]>([]);
  const fileRef = useRef<HTMLInputElement>(null);
  const cameraRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    const h = localStorage.getItem('vin_history');
    if (h) setHistory(JSON.parse(h));
  }, []);

  const saveHistory = (vin: string, vehicle: VehicleData) => {
    const entry = { vin, make: vehicle.make||'', model: vehicle.model||'', year: vehicle.year||'' };
    const updated = [entry, ...history.filter(h => h.vin !== vin)].slice(0, 10);
    setHistory(updated);
    localStorage.setItem('vin_history', JSON.stringify(updated));
  };

  const search = async (vinCode?: string) => {
    const v = (vinCode || vin).trim().toUpperCase();
    if (v.length !== 17) return setError('VIN კოდი 17 სიმბოლო უნდა იყოს');
    setLoading(true); setError(''); setResult(null);
    try {
      const r = await api.get(`/api/vin/decode?vin=${v}`);
      const vinData = r.data.data || r.data;
      setResult(vinData);
      if (vinData?.vehicle) saveHistory(v, vinData.vehicle);
    } catch(e: any) {
      setError(e.response?.data?.message || 'შეცდომა');
    }
    setLoading(false);
  };

  const handleOCR = async (file: File) => {
    setOcrLoading(true); setError('');
    try {
      const buffer = await file.arrayBuffer();
      const r = await api.post('/api/vin/ocr', buffer, {
        headers: { 'Content-Type': file.type }
      });
      if (r.data.vin) {
        setVin(r.data.vin);
        setTab('manual');
        await search(r.data.vin);
      } else {
        setError(r.data.message || 'VIN ვერ მოიძებნა');
      }
    } catch(e: any) {
      setError('OCR შეცდომა');
    }
    setOcrLoading(false);
  };

  const confidenceColor = result?.confidence === 'high' ? 'text-green-700 bg-green-50 border-green-200'
    : result?.confidence === 'medium' ? 'text-yellow-700 bg-yellow-50 border-yellow-200'
    : 'text-red-700 bg-red-50 border-red-200';

  return (
    <div className="page-container py-8 max-w-lg mx-auto">
      <div className="flex items-center gap-3 mb-6">
        <h1 className="text-2xl font-extrabold text-dark">🔍 VIN ძებნა</h1>
        <Link href="/vin-batch" className="text-xs bg-purple-100 text-purple-700 px-3 py-1 rounded-full font-bold hover:bg-purple-200">
          📋 Batch B2B
        </Link>
      </div>

      {/* Tabs */}
      <div className="flex gap-1 bg-gray-100 rounded-xl p-1 mb-5">
        {[
          { key: 'manual', label: '⌨️ ხელით' },
          { key: 'camera', label: '📷 სკანი' },
          { key: 'history', label: '🕐 ისტორია' },
        ].map(t => (
          <button key={t.key} onClick={() => setTab(t.key as any)}
            className={`flex-1 py-2 rounded-lg text-sm font-medium transition-colors ${tab===t.key?'bg-white shadow text-dark':'text-gray-500'}`}>
            {t.label}
          </button>
        ))}
      </div>

      {/* Manual Input */}
      {tab === 'manual' && (
        <div className="bg-white border border-gray-200 rounded-2xl p-5 mb-4">
          <label className="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2 block">VIN კოდი</label>
          <div className="flex gap-2">
            <input value={vin}
              onChange={e => { setVin(e.target.value.toUpperCase()); setError(''); }}
              onKeyDown={e => e.key === 'Enter' && search()}
              maxLength={17} placeholder="1HGCM82633A004352"
              className="input-field flex-1 font-mono text-sm tracking-widest" />
            <button onClick={() => search()} disabled={loading || vin.length !== 17}
              className="btn-primary px-5 disabled:opacity-50">
              {loading ? '...' : '🔍'}
            </button>
          </div>
          <div className="flex justify-between mt-2">
            <span className="text-xs text-gray-400">{vin.length}/17</span>
            {vin.length === 17 && <span className="text-xs text-green-600">✓ სწორი სიგრძე</span>}
          </div>
          {error && <p className="text-sm text-red-600 mt-2">{error}</p>}
        </div>
      )}

      {/* Camera/OCR */}
      {tab === 'camera' && (
        <div className="bg-white border border-gray-200 rounded-2xl p-5 mb-4 space-y-3">
          <p className="text-sm text-gray-500">სურათიდან ავტომატურად წავიკითხავთ VIN კოდს</p>

          <input ref={cameraRef} type="file" accept="image/*" capture="environment"
            className="hidden" onChange={e => e.target.files?.[0] && handleOCR(e.target.files[0])} />
          <input ref={fileRef} type="file" accept="image/*"
            className="hidden" onChange={e => e.target.files?.[0] && handleOCR(e.target.files[0])} />

          <button onClick={() => cameraRef.current?.click()} disabled={ocrLoading}
            className="w-full bg-blue-600 text-white rounded-xl py-3 font-bold text-sm hover:bg-blue-700 disabled:opacity-50">
            {ocrLoading ? '⏳ იკითხება...' : '📷 კამერით გადაღება'}
          </button>
          <button onClick={() => fileRef.current?.click()} disabled={ocrLoading}
            className="w-full border border-gray-200 rounded-xl py-3 text-sm font-medium hover:bg-gray-50 disabled:opacity-50">
            🖼️ გალერეიდან არჩევა
          </button>

          {error && <p className="text-sm text-red-600">{error}</p>}

          <div className="bg-blue-50 border border-blue-200 rounded-xl p-3">
            <p className="text-xs text-blue-700 font-medium mb-1">📍 VIN სად არის?</p>
            <ul className="text-xs text-blue-600 space-y-0.5">
              <li>• მძღოლის კარის ჩარჩოზე</li>
              <li>• საქარე მინის ქვედა ნაწილში</li>
              <li>• სადაზღვევო პოლისში</li>
            </ul>
          </div>
        </div>
      )}

      {/* History */}
      {tab === 'history' && (
        <div className="bg-white border border-gray-200 rounded-2xl overflow-hidden mb-4">
          {history.length === 0 ? (
            <div className="p-8 text-center text-gray-400">
              <p className="text-3xl mb-2">🕐</p>
              <p>ძებნის ისტორია ცარიელია</p>
            </div>
          ) : (
            <div className="divide-y divide-gray-100">
              {history.map((h, i) => (
                <button key={i} onClick={() => { setVin(h.vin); setTab('manual'); search(h.vin); }}
                  className="w-full px-5 py-3 flex items-center justify-between hover:bg-gray-50 text-left">
                  <div>
                    <p className="font-mono text-xs text-gray-400">{h.vin}</p>
                    <p className="font-medium text-sm">{h.make} {h.model} {h.year}</p>
                  </div>
                  <span className="text-gray-400">→</span>
                </button>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Result */}
      {result && (
        <div className="bg-white border border-gray-200 rounded-2xl p-5 space-y-4">
          <div className={`rounded-xl px-4 py-3 border text-sm font-medium ${confidenceColor}`}>
            {result.confidenceMsg} — {result.score}/100
          </div>
          <div>
            <p className="text-xl font-extrabold text-dark">
              {result.vehicle.make} {result.vehicle.model} {result.vehicle.year}
            </p>
            {result.vehicle.bodyClass && <p className="text-sm text-gray-400">{result.vehicle.bodyClass}</p>}
          </div>
          <div className="grid grid-cols-2 gap-3">
            {[
              { label: '⛽ საწვავი', value: result.vehicle.fuelType },
              { label: '🔧 მოცულობა', value: result.vehicle.displacement ? `${parseFloat(result.vehicle.displacement).toFixed(1)}L` : null },
              { label: '⚙️ ცილინდრი', value: result.vehicle.engineCyl ? `${result.vehicle.engineCyl} cyl` : null },
              { label: '🔄 გადაცემათა', value: result.vehicle.transmission },
              { label: '🌍 ქვეყანა', value: result.vehicle.plantCountry },
            ].filter(x => x.value).map(x => (
              <div key={x.label} className="bg-gray-50 rounded-xl p-3">
                <p className="text-xs text-gray-400 mb-1">{x.label}</p>
                <p className="text-sm font-medium text-dark">{x.value}</p>
              </div>
            ))}
          </div>
          <a href={`/parts?q=${result.vehicle.make}+${result.vehicle.model}`}
            className="flex items-center justify-between w-full bg-blue-600 hover:bg-blue-700 text-white rounded-xl px-4 py-3 text-sm font-medium transition-colors">
            <span>🔩 ამ მანქანის ნაწილები</span>
            <span>→</span>
          </a>
        </div>
      )}
    </div>
  );
}
